{
  "upstreamVersion": "1.4.4",
  "SELECTORS": {
    "sidebarRail": [
      "c-wiz:has([aria-label=\"List of Direct Messages\"])",
      "div:has(> [role=\"list\"][aria-label=\"List of Direct Messages\"])",
      "c-wiz:has([role=\"listitem\"][data-group-id])"
    ],
    "dmList": [
      "[role=\"list\"][aria-label=\"List of Direct Messages\"]",
      "[role=\"list\"]:has([role=\"listitem\"][data-group-id^=\"dm/\"])"
    ],
    "spacesList": [
      "[role=\"list\"][aria-label=\"List of spaces.\"]",
      "[role=\"list\"]:has([role=\"listitem\"][data-group-id^=\"space/\"])"
    ],
    "topBar": [
      "header[role=\"banner\"]",
      "[role=\"banner\"]"
    ],
    "search": [
      "[role=\"search\"]",
      "form[role=\"search\"]"
    ],
    "conversationPane": [
      "[role=\"main\"]"
    ],
    "composeBox": [
      "[role=\"textbox\"]"
    ],
    "convRow": [
      "[role=\"listitem\"][data-group-id]"
    ],
    "unreadToggle": [
      "button[role=\"switch\"][aria-label=\"Unread\"]",
      "button[role=\"switch\"][aria-label*=\"unread\" i]"
    ],
    "spaceRow": [
      "[role=\"listitem\"][data-group-id^=\"space/\"]"
    ],
    "dmRow": [
      "[role=\"listitem\"][data-group-id^=\"dm/\"]"
    ],
    "unreadRow": [
      "[data-is-unread=\"true\"]"
    ],
    "starredRow": [
      "[role=\"listitem\"][data-starred=\"true\"]"
    ],
    "meetingRow": [
      "[role=\"listitem\"][data-group-type=\"10\"]"
    ],
    "messageTopic": [
      "c-wiz[data-topic-id]",
      "[data-topic-id]"
    ],
    "reaction": [
      "[data-emoji]"
    ],
    "userMention": [
      "[data-user-mention-type]"
    ],
    "codeInline": [
      "[role=\"main\"] code"
    ],
    "codeBlock": [
      "[role=\"main\"] pre"
    ],
    "dividerHeading": [
      "[role=\"heading\"][aria-level=\"2\"]",
      "[role=\"heading\"]"
    ],
    "dateHeading": [
      "[data-absolute-timestamp][data-format=\"3\"]"
    ],
    "threadReply": [
      "[role=\"main\"] [data-last-reply-time-msec]"
    ],
    "messageTimestamp": [
      "[role=\"main\"] [data-absolute-timestamp]"
    ],
    "searchInput": [
      "[role=\"search\"] input",
      "[role=\"search\"] [contenteditable]"
    ],
    "searchDropdown": [
      "[role=\"banner\"] [role=\"listbox\"]"
    ],
    "bannerMenu": [
      "[role=\"banner\"] [role=\"menu\"]"
    ],
    "newChat": [
      "[data-slackify=\"rail\"] [data-is-fab]"
    ],
    "chatLogo": [
      "[role=\"banner\"] img[src*=\"chatlogo\"]"
    ],
    "selfAvatar": [
      "[role=\"banner\"] [aria-label^=\"Google Account\"] img",
      "[role=\"banner\"] img[src*=\"googleusercontent.com\"]"
    ],
    "selfMessageAuthor": [
      "[data-compare-to-self-user=\"true\"][data-name]"
    ],
    "mainRow": [
      "[role=\"main\"] [role=\"listitem\"]",
      "[role=\"main\"] [role=\"row\"]"
    ],
    "messageContainer": [
      "[role=\"main\"] [data-message-id]",
      "[role=\"main\"] [data-is-tombstone-message-view]"
    ],
    "messageToolbar": [
      "[role=\"main\"] [role=\"toolbar\"]"
    ],
    "senderName": [
      "[role=\"main\"] span[data-name][data-is-message]"
    ],
    "railInteractive": [
      "button",
      "[role=\"button\"]",
      "[role=\"listitem\"]",
      "[jsaction]"
    ]
  },
  "TAGS": {
    "rail": "[data-slackify=\"rail\"]",
    "bubble": "[data-slackify=\"bubble\"]",
